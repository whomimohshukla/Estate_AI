POSTGRES_USER=estateai
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=estateai

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://estateai:replace-with-a-strong-postgres-password@postgres:5432/estateai?schema=public
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace-with-a-64-character-random-access-secret-0000000000000000
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-refresh-secret-000000000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost
GEMINI_API_KEY=replace-with-production-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=/app/uploads

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EstateAI <no-reply@estateai.local>

VITE_API_BASE_URL=/api/v1
